{
  "ci": {
    "collect": {
      "numberOfRuns": 1,
      "startServerCommand": "npm --prefix frontend run preview -- --port 4173 --host 127.0.0.1",
      "startServerReadyPattern": "4173",
      "startServerReadyTimeout": 30000,
      "url": [
        "http://127.0.0.1:4173/",
        "http://127.0.0.1:4173/catalog",
        "http://127.0.0.1:4173/product/prod_1"
      ],
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 390,
          "height": 844,
          "deviceScaleFactor": 2,
          "disabled": false
        },
        "throttlingMethod": "provided",
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.85 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }]
      }
    }
  }
}
